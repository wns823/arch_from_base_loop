{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(harness/bin/agh:*)",
      "Bash(nvidia-smi:*)",
      "Bash(sha256sum:*)"
    ],
    "deny": [
      "Bash(rm -rf runs:*)",
      "Bash(rm -rf ~/ag_harness_private:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|Write|Edit|Bash|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/policy.py guard",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/policy.py log",
            "timeout": 10
          }
        ]
      }
    ]
  }
}